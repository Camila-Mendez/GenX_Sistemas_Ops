# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Nombre del nodo que se muestra en el panel (opcional; por defecto el hostname)
GENX_NODE_NAME=srv-activo

# Motor: sqlite | mysql | postgresql | sqlserver
DB_ENGINE=postgresql
DB_HOST=10.0.0.10
DB_PORT=5432
DB_NAME=genx_portal
DB_USER=genx_app
DB_PASSWORD=cambia-esta-contraseña

# Solo SQL Server: nombre del driver ODBC instalado
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Alternativa: una sola cadena de conexión de SQLAlchemy (tiene prioridad)
# DATABASE_URL=postgresql+psycopg2://genx_app:clave@10.0.0.10:5432/genx_portal
